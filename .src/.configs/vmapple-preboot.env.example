APPLESILICON_QEMU_BIN=/absolute/path/to/qemu-system-aarch64
APPLESILICON_VMAPPLE_ACCEL=tcg
APPLESILICON_VMAPPLE_CPU_PROFILE=max
APPLESILICON_VMAPPLE_SMP=4
APPLESILICON_VMAPPLE_RAM=4G
APPLESILICON_VMAPPLE_UUID=
APPLESILICON_VMAPPLE_FIRMWARE=/absolute/local/path/to/AVPBooter.vmapple2.bin
APPLESILICON_VMAPPLE_AUX=/absolute/local/path/to/aux.img.trimmed
APPLESILICON_VMAPPLE_DISK=/absolute/local/path/to/disk.img
APPLESILICON_P1_07_PROBE_SECONDS=30
APPLESILICON_P1_07_GRACE_SECONDS=3
APPLESILICON_P1_07_DEBUG_ITEMS=guest_errors,unimp,int,cpu_reset
