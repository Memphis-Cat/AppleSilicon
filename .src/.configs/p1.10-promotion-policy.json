{
  "schema": 1,
  "project_version": "1.0.0.0.0.0",
  "promotion_id": "P01-DIVERGENCE-0001",
  "minimum_reproductions": 2,
  "minimum_canonical_events_per_trace": 1,
  "require_structured_trace_events": true,
  "require_unique_run_pairs": true,
  "require_unique_reference_runs": true,
  "require_unique_probe_runs": true,
  "require_candidate_fingerprint": true,
  "require_same_contract_fingerprint": true,
  "require_same_divergence_signature": true,
  "auto_commit_promotion": false,
  "reference_result_prefixes": [
    "P1_09_REFERENCE_"
  ],
  "probe_result_prefixes": [
    "P1_07_PROBE_"
  ],
  "blocked_result_fragments": [
    "synthetic",
    "fixture",
    "self-check",
    "example"
  ],
  "allowed_trace_artifact_kinds": [
    "serial_log",
    "qemu_debug_log"
  ],
  "requirements": {
    "empty_canonical_stream_is_insufficient_evidence": true,
    "unstructured_trace_fallback_is_not_promotable_runtime_evidence": true,
    "candidate_fingerprint_must_reproduce": true,
    "candidate_id_must_reproduce": true,
    "independent_reference_runs_required": true,
    "independent_probe_runs_required": true
  }
}