  "features": [
    {
      "name": "vmapple_virtual_platform_tolerance",
      "class": "xnu_virtual_platform_contract",
      "source_evidence": [
        "xnu_proc_reg"
      ],
      "facts": [
        "XNU contains APPLEVIRTUALPLATFORM-specific ARM64 behavior.",
        "SCTLR_EL1.EPAN is treated as optional on the Apple virtual platform and may be read-as-zero/write-ignored on some hosts."
      ],
      "runtime_priority": "unknown",
      "implementation_state": "inventory_only"
    },
    {
      "name": "pointer_authentication",
      "class": "architectural_feature_with_apple_policy",
      "source_evidence": [
        "xnu_proc_reg",
        "m1n1_cpu_regs"
      ],
      "facts": [
        "XNU conditionally configures SCTLR pointer-authentication key enables under HAS_APPLE_PAC.",
        "m1n1 records Apple implementation-defined APCTL/APSTS/APVMKEY control registers separately from architectural PAuth registers."
      ],
      "runtime_priority": "unknown",
      "implementation_state": "inventory_only"
    },
    {
      "name": "translation_granules",
      "class": "architectural_mmu_feature",
      "source_evidence": [
        "xnu_proc_reg"
      ],
      "facts": [
        "XNU defines both 16 KiB and 4 KiB TCR translation-granule encodings and has mixed-page-size support paths.",
        "P2.01 does not infer which exact granule combination the future VMApple guest run will require."
      ],
      "runtime_priority": "unknown",
      "implementation_state": "inventory_only"
    },
    {
      "name": "apple_implementation_defined_sysregs",
      "class": "implementation_defined_register_space",
      "source_evidence": [
        "m1n1_cpu_regs",
        "qemu_cpregs"
      ],
      "facts": [
        "m1n1 documents Apple system-register encodings in op0/op1/CRn/CRm/op2 form.",
        "QEMU ARMCPRegInfo supports AArch64 system-register encodings and read/write/access/reset callbacks."
      ],
      "runtime_priority": "unknown",
      "implementation_state": "inventory_only"
    },
    {
      "name": "gxf_sprr",
      "class": "apple_implementation_defined_feature_family",
      "source_evidence": [
        "m1n1_cpu_regs"
      ],
      "facts": [
        "m1n1 documents GXF and SPRR configuration, status, permission, and guarded-state register encodings.",
        "P2.01 does not claim VMApple requires these registers."
      ],
      "runtime_priority": "unknown",
      "implementation_state": "inventory_only"
    },
    {
      "name": "amx_control",
      "class": "apple_implementation_defined_feature_family",
      "source_evidence": [
        "m1n1_cpu_regs"
      ],
      "facts": [
        "m1n1 documents AMX context/state/control system-register encodings.",
        "No AMX execution semantics are implemented by P2.01."
      ],
      "runtime_priority": "unknown",
      "implementation_state": "inventory_only"
    }
  ],
